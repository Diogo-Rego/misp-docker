ARG DOCKER_HUB_PROXY=""
ARG MISP_UID=1001
ARG MISP_GID=1001


FROM "${DOCKER_HUB_PROXY}ubuntu:24.04" AS python-build
ENV DEBIAN_FRONTEND=noninteractive
ARG MODULES_TAG
ARG MODULES_COMMIT

# Uncomment when building in corporate environments
# COPY ./cert.pem /usr/local/share/ca-certificates/rootca.pem
# COPY ./cert.pem /usr/lib/ssl/cert.pem

RUN <<-EOF
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        build-essential \
        libfuzzy-dev \
        libpoppler-cpp-dev \
        python3 \
        python3-pip \
        python3-venv \
        python3-dev
    apt-get autoremove -y && apt-get clean -y && rm -rf /var/lib/apt/lists/*
EOF

RUN mkdir /wheels

WORKDIR /srv/misp-modules

RUN <<-EOF
    if [ -n "${MODULES_COMMIT}" ]; then
        git clone https://github.com/MISP/misp-modules.git . && git checkout "${MODULES_COMMIT}"
    else
        git clone --branch "${MODULES_TAG}" --depth 1 https://github.com/MISP/misp-modules.git .
    fi
EOF

RUN pip3 install --no-cache-dir --break-system-packages poetry poetry-plugin-bundle poetry-plugin-export && \
    poetry export -E all --without-hashes -f requirements.txt -o requirements.txt && \
    pip3 wheel -r requirements.txt --no-cache-dir -w /wheels/ && \
    poetry build --output /wheels/

WORKDIR /srv/
RUN rm -rf /srv/misp-modules


FROM "${DOCKER_HUB_PROXY}ubuntu:24.04"
ENV DEBIAN_FRONTEND=noninteractive
ARG MISP_UID
ARG MISP_GID

RUN <<-EOF
    apt-get update
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        libgl1 \
        libfuzzy2 \
        libpoppler-cpp0t64 \
        libzbar0t64 \
        tesseract-ocr
    apt-get autoremove -y && apt-get clean -y && rm -rf /var/lib/apt/lists/*
EOF

RUN groupadd -g "${MISP_GID}" misp && \
    useradd -l -u "${MISP_UID}" -g "${MISP_GID}" -m -d /home/misp -s /usr/sbin/nologin misp

RUN --mount=type=bind,from=python-build,source=/wheels,target=/wheels \
    pip3 install --no-cache-dir --break-system-packages /wheels/*.whl

# Installation is complete. Remove pip from runtime to reduce attack surface
RUN python3 -m pip uninstall --yes --break-system-packages pip || true

RUN bash -c 'mkdir -p /custom/{action_mod,expansion,export_mod,import_mod} && chown -R misp:misp /custom'

USER ${MISP_UID}

EXPOSE 6666

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD [ "bash", "-c", "</dev/tcp/127.0.0.1/6666 || exit 1" ]

ENTRYPOINT [ "/usr/local/bin/misp-modules", "-l", "0.0.0.0", "-c", "/custom/"]
